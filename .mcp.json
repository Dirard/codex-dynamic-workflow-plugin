{
  "mcpServers": {
    "claude-workflow": {
      "command": "node",
      "args": [
        "./scripts/workflow-mcp.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_BASE_URL",
        "WORKFLOW_MODEL",
        "WORKFLOW_MIN_QUOTA_REMAINING_PERCENT",
        "WORKFLOW_QUOTA_URL",
        "XDG_CONFIG_HOME"
      ],
      "tool_timeout_sec": 31536000
    }
  }
}
